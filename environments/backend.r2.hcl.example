# Shared R2 backend settings. Supply a unique `key` at init time per root.
# Keep credentials out of git; Terraform's S3 backend reads
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
bucket = "CHANGE_ME_TERRAFORM_STATE_BUCKET"
region = "auto"

endpoints = {
  s3 = "https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com"
}

use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
