# zed-pkg environment schema — names and meanings only, never real values.
# Real values live encrypted in env/enc/<name>.env.enc (sops + age).
# Edit with `just edit <name>`; activate with `just use <name>`.

# --- Cloudflare (zpkg.net zone) ---------------------------------------------
# Account id and zone id are identifiers, not secrets; they appear in API URLs.
CLOUDFLARE_ACCOUNT_ID=62b833940607839add74bd2379cac303
ZPKG_NET_ZONE_ID=b559136046dcffc550ee8b3ed49cdf09
# Zone-scoped token for zpkg.net (Zone:DNS:Edit; add Account:R2 write only if
# terraform manages the buckets with it). Mint in the Cloudflare dashboard and
# enter it via `just edit <name>` ONLY — a token that transits chat, a shell
# command, or a plaintext file is burned and must be revoked (see the
# credential policy / DEN-2836).
CLOUDFLARE_API_TOKEN_ZPKG=EXAMPLE-mint-in-dashboard-enter-via-just-edit

# --- Supabase (zed-pkg project) ---------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://zxjvldcyqobiupeiwjhx.supabase.co  # zed-pkg's Supabase project (ref is non-secret)
# Publishable key: public by design (ships in clients). Consumers: the zed CLI
# reads it as ZED_PKG_SUPABASE_KEY alongside ZED_PKG_SUPABASE_URL.
SUPABASE_PUBLISHABLE_KEY=EXAMPLE-sb_publishable_xxx
# Secret (server-side) key: never leaves this store except into server env.
SUPABASE_SECRET_KEY=EXAMPLE-rotate-in-dashboard-enter-via-just-edit
